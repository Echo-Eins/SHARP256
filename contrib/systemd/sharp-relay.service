# sharp-relay as a system service (docs/RELAY.md).
#
#   install -m 0755 sharp-relay /usr/local/bin/
#   install -m 0644 contrib/systemd/sharp-relay.service /etc/systemd/system/
#   install -d -m 0755 /etc/sharp-relay
#   printf 'RELAY_ARGS=--stun 203.0.113.7\n' > /etc/sharp-relay/relay.env   # this host's address
#   systemctl daemon-reload && systemctl enable --now sharp-relay
#   journalctl -u sharp-relay | grep Receivers:     # the line receivers are given
#
# The identity (the relay's long-term key) lives in /var/lib/sharp-relay and
# is made at the first start; keep a copy, since receivers name the relay by
# it. Everything else the relay holds is in memory.

[Unit]
Description=SHARP-256 relay (rendezvous and carrier for senders and receivers)
Documentation=https://github.com/Echo-Eins/SHARP256/blob/main/docs/RELAY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
EnvironmentFile=-/etc/sharp-relay/relay.env
# UDP and TCP on 5560, TLS on 443, STUN on 3478 and 3479 (RELAY_ARGS adds
# --stun with this host's address, the lists and the quotas).
ExecStart=/usr/local/bin/sharp-relay \
    --bind [::]:5560 \
    --tls [::]:443 \
    --identity ${STATE_DIRECTORY}/relay.key \
    --log info \
    $RELAY_ARGS
Restart=on-failure
RestartSec=5s

# Nobody's account: a user made for the service while it runs.
DynamicUser=yes
StateDirectory=sharp-relay
StateDirectoryMode=0700
ConfigurationDirectory=sharp-relay
# Port 443 is below 1024; nothing else is needed.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Keys are kept in locked memory (docs/THREAT_MODEL.md, §5a).
LimitMEMLOCK=16M
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
